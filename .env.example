# Copy this file to .env and change values for your deployment.

# Database configuration
# For Docker Compose, use postgresql+asyncpg://USER:PASSWORD@db:5432/afterfire
# For local development, use sqlite+aiosqlite:///./afterfire.db
DATABASE_URL=postgresql+asyncpg://afterfire:afterfire@db:5432/afterfire

# Geographic analysis area (west,south,east,north; WGS84 decimal degrees)
# Example: a small area in eastern Sicily, Italy
ANALYSIS_BBOX=14.7,37.1,15.4,37.8
ANALYSIS_REGION_NAME=Sicily East

# Initial analysis period (editable; dates are not hardcoded in application logic)
ANALYSIS_START_DATE=2024-01-01
ANALYSIS_END_DATE=2026-10-27

# Download and storage limits
MAX_DOWNLOAD_DAYS_PER_REQUEST=5
MAX_CONCURRENT_DOWNLOADS=2
MAX_DOWNLOAD_SIZE_MB=250
DATA_CACHE_ENABLED=true
ALLOW_GLOBAL_DOWNLOADS=false

# NASA FIRMS API MAP KEY (optional; obtain a personal key from NASA FIRMS)
FIRMS_MAP_KEY=

# NASA Earthdata Login (optional; not used by current automated dataset downloaders)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# AI analyst key (optional)
LLM_API_KEY=

# Demo mode (true/false)
DEMO_MODE=false

# Event-scoped NASA MODIS analysis; source cache is separate from FIRMS.
EARTHDATA_TOKEN=
AFTERFIRE_ANALYSIS_ON_DEMAND=true
AFTERFIRE_ANALYSIS_WORKERS=1
AFTERFIRE_ANALYSIS_MAX_CONCURRENT_DOWNLOADS=2
AFTERFIRE_ANALYSIS_PRE_EVENT_YEARS=3
AFTERFIRE_ANALYSIS_MAX_POST_EVENT_YEARS=10
AFTERFIRE_ANALYSIS_CACHE_MAX_GB=10
AFTERFIRE_ANALYSIS_MAX_JOB_GB=5
AFTERFIRE_ANALYSIS_MAX_GRANULES=400
AFTERFIRE_ANALYSIS_MAX_AREA_KM2=2500
AFTERFIRE_ANALYSIS_KEEP_SOURCE_GRANULES=true
AFTERFIRE_ANALYSIS_CACHE_POLICY=retain
AFTERFIRE_ANALYSIS_MIN_FREE_GB=1

# Native-grid equivalence evidence: docs/phase4-equivalence.json.
AFTERFIRE_APPEEARS_ENABLED=true
AFTERFIRE_APPEEARS_WAIT_SECONDS=1800
AFTERFIRE_ANALYSIS_MAX_BLOCK_GB=1
AFTERFIRE_ANALYSIS_TEMP_MAX_GB=1
AFTERFIRE_ANALYSIS_RESULTS_MAX_GB=2

# Phase 5: durable preflight and NASA metadata (separate from scientific source cache)
AFTERFIRE_CATALOG_CACHE_ENABLED=true
AFTERFIRE_CATALOG_CACHE_TTL_HOURS=24
AFTERFIRE_PREFLIGHT_TTL_HOURS=6
AFTERFIRE_CACHE_AUTO_CLEANUP=true
AFTERFIRE_CACHE_CLEANUP_THRESHOLD_PERCENT=85
AFTERFIRE_CACHE_TARGET_PERCENT=70
# Resource diagnostics disabled unless a private administrator bearer token is configured.
AFTERFIRE_ADMIN_TOKEN=

AFTERFIRE_RECOVERY_MAX_CELL_OBSERVATIONS=2000000

# Existing subset reads remain available; new remote tasks are opt-in only.
AFTERFIRE_APPEEARS_SUBMISSION_ENABLED=false
AFTERFIRE_ANALYSIS_NO_PROGRESS_SECONDS=180
AFTERFIRE_ANALYSIS_OPERATION_TIMEOUT_SECONDS=600
AFTERFIRE_ANALYSIS_HEARTBEAT_TIMEOUT_SECONDS=60

# API-first satellite acquisition. Never enable billing automatically.
AFTERFIRE_API_FIRST=true
AFTERFIRE_FULL_HDF_AUTO_DOWNLOAD=false
AFTERFIRE_SATELLITE_PROVIDER=auto
AFTERFIRE_ORNL_ENABLED=true
AFTERFIRE_EARTH_ENGINE_ENABLED=false
AFTERFIRE_EE_PROJECT_ID=
# For compose.earth-engine.yaml only: absolute path OUTSIDE this repository.
# Existing ADC / workload-identity configuration file, never a pasted token.
AFTERFIRE_GOOGLE_CREDENTIALS_FILE=
AFTERFIRE_API_MAX_REQUESTS=1000
AFTERFIRE_API_MAX_RESPONSE_MB=16
AFTERFIRE_API_MAX_PIXELS=100000
