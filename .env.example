# AfterFire Environment Configuration
# Copy this file to .env and adjust variables as needed

# Database configuration
# For Docker Compose: postgresql+asyncpg://afterfire:afterfire@db:5432/afterfire
# For local dev without Docker: sqlite+aiosqlite:///./afterfire.db
DATABASE_URL=sqlite+aiosqlite:///./afterfire.db

# NASA FIRMS API MAP KEY (Optional - get your free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# If empty, the app runs in transparent calibrated demo & CSV upload mode
FIRMS_MAP_KEY=REMOVED_FIRMS_KEY

# NASA Earthdata Login Credentials (Optional - for direct LP DAAC automated retrieval)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# AI Analyst Key (Optional - for OpenAI GPT-4o-mini scientific reasoning grounded in backend metrics)
# If empty, AfterFire uses its built-in deterministic scientific explainer with zero hallucination
LLM_API_KEY=

# Demo mode toggle (true/false)
DEMO_MODE=true
